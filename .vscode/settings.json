    {
        "*.hxp": "haxe",

        "*.hscript": "haxe",
        "*.hclass": "haxe",
        "*.hmodule": "haxe",
        
        "*.haxe": "haxe",
        "*.hxs": "haxe",
        "*.hxc": "haxe",
        "*.hxm": "haxe"
    },
}