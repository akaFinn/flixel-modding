{
    "lime.projectFile": "samples/sample-2/Project.xml",

    "[haxe]": 
    {
        "editor.tabSize": 4,
    },

    "[haxe-script]": 
    {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
    },
    
