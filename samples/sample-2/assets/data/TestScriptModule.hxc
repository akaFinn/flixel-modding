package assets.data;

import flixel.FlxG;
import flixel.FlxSprite as Sprite;
import assets.data.TestSprite;

using StringTools;

enum TestEnum
{
    STUPID_ONE;
    STUPID_TWO;
    RGB(r:Int, g:Int, b:Int);
}

typedef TestTypedef =
{
    var shit:String;
    var ?poop:Int;
}

final class TestScript extends Sprite
{
    public static var helloWorld:String = "Hello, World!";

    static var testicle(default, set):Float = 1;

    static function set_testicle(value:Float):Float
    {
        return value * 10;
    }

    public var name:String;

    public var stupid(default, set):Int = 5;

    function set_stupid(value:Int):Int
    {
        trace(value);
        return value * 5;
    }

    static var mainIndex:Int = 0;

    public static function main(?number:Float = 5):Void
    {
        mainIndex++;
        trace('${helloWorld} ${number * 3}');

        if (mainIndex < 3)
        {
            trace(mainIndex);
            main();
        }
        else
        {
            trace('Hip Hip Hooray! ${testicle}');
            testicle = 1 * number;
            trace('${testicle}');
        }
    }

    public function new(name:String)
    {
        trace(this);
        trace(stupid);

        stupid = 10;

        trace(this.stupid);

        this.name = name;

        super(30, 0);

        super.makeGraphic(256, 256);
        this.screenCenter();

        TestSprite.test();

        var testSprite:TestSprite = new TestSprite();
        trace(testSprite);
    }

    public function sayHello():Void
    {
        trace('${helloWorld} My name is ${this.name}');
    }

    function toString():String
    {
        return 'Howdy Nice Guy!';
    }
}