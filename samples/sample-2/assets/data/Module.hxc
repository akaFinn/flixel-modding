package assets.data;

import assets.data.ImportModule;

class TestClass1
{
    public static var text:String = "Hello World!";

    private static var size:Float = 64;

    public static function main():Void
    {
        trace(text);
    }

    public static function mega(text:String):Void
    {
        trace(text);
        trace(size);

        trace(TestClass2.text);
        trace(TestClass2.getCoolText());
        trace(TestClass3.text);

        trace(ImportModule.importText);
        trace(ImportModule.getCoolerText());
    }

    static function toString():String
    {
        return "TestClass1 is Awesome";
    }
}

class TestClass2
{
    public static var text:String = "Hello Other World!";

    public static function getCoolText():String
    {
        return "Hello Cool World!";
    }
}

class TestClass3
{
    public static var text:String = "Hello Other Other World!";
